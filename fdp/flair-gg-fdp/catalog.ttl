# ── Virtual Platform ────────────────────────────────────────────────────

:virtual-platform
    a dcat:Dataset ;
    dcterms:title "FLAIR-GG Virtual Platform — federated access to all members"@en ;
    dcterms:description "The Virtual Platform indexes the FAIR Data Points of all member banks plus third-party services and runs federated queries and analytics over them. It also federates UniProt SPARQL (described in the UniProt catalog of this FDP)."@en ;
    dcterms:identifier "FLAIR-GG-VP" ;
    dcterms:version "live (described 2026-10-07)" ;
    dcterms:publisher :publisher-flairgg ;
    dcat:landingPage <https://wilkinsonlab.github.io/FLAIR-GG/VP/index.html> ;
    rdfs:seeAlso <https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/uniprot-fdp/catalog.ttl> ;
    dcat:distribution :dist-vp-portal , :dist-vp-index , :dist-vp-proxy , :dist-vp-driada , :dist-vp-ena , :dist-vp-swagger .

:dist-vp-portal
    a dcat:Distribution ;
    dcterms:title "FLAIR-GG Virtual Platform portal"@en ;
    dcterms:description "How to get it: open the portal in a browser to search catalogs, datasets and services of all member banks and run federated queries; no account needed."@en ;
    dcterms:type am:aggregator-mirror ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/html> ;
    dcat:accessURL <https://vp.bgv.cbgp.upm.es> .

:dist-vp-index
    a dcat:Distribution ;
    dcterms:title "Virtual Platform resource index — JSON"@en ;
    dcterms:description "How to get it: GET https://vp.linkeddata.systems returns a JSON array of every indexed FDP, catalog, dataset and data service (resource, title, type); 60 entries over six banks on 2026-10-07. Handy to discover new members."@en ;
    dcterms:type am:rest-api ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/json> ;
    dcterms:format ft:JSON ;
    dcat:accessURL <https://vp.linkeddata.systems> .

:dist-vp-proxy
    a dcat:Distribution ;
    dcterms:title "FDP Index Proxy — register a DCAT document"@en ;
    dcterms:description "How to get it: POST {'clientUrl': 'https://my.server.org/my_dcat_record.ttl'} as application/json to the proxy; it adds the metadata the platform requires and indexes your record, so a plain DCAT file is enough to join."@en ;
    dcterms:type am:rest-api ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/json> ;
    dcat:accessURL <https://wilkinsonlab.github.io/FLAIR-GG/Proxy/index.html> ;
    dcat:accessService :svc-vp-proxy .

:dist-vp-driada
    a dcat:Distribution ;
    dcterms:title "Dríada — legal protection status of Spanish flora"@en ;
    dcterms:description "How to get it: GET https://vp.linkeddata.systems/wrapped-services/driada/lookup?species=Abies%20pinsapo returns CSV rows with the protection level (national or regional), region, family, category and official bulletin reference from the Spanish Catalogue of Threatened Species, the special-protection list and regional catalogues."@en ;
    dcterms:type am:rest-api ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/csv> ;
    dcterms:format ft:CSV ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcat:accessURL <https://vp.linkeddata.systems/wrapped-services/driada/lookup> ;
    dcat:accessService :svc-vp-driada .

:dist-vp-ena
    a dcat:Distribution ;
    dcterms:title "ENA sequence retrieval via TogoWS"@en ;
    dcterms:description "How to get it: GET http://togows.org/entry/ebi-ena/ACCESSION to fetch a sequence by its ENA accession; the Virtual Platform uses it to link germplasm species to sequence surveys."@en ;
    dcterms:type am:rest-api ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/plain> ;
    dcat:accessURL <http://togows.org/> ;
    dcat:accessService :svc-vp-ena .

:dist-vp-swagger
    a dcat:Distribution ;
    dcterms:title "Swagger UI for the FLAIR-GG service interfaces"@en ;
    dcterms:description "How to get it: try every OpenAPI interface (SPARQL endpoints, lookups, wrapped services) interactively in the browser."@en ;
    dcterms:type am:web-portal ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/html> ;
    dcat:accessURL <https://bgv.cbgp.upm.es/swagger> .

:svc-vp-proxy  a dcat:DataService ; dcterms:title "FLAIR-GG FDP Index Proxy"@en ; dcat:endpointURL <https://bgv.cbgp.upm.es/fdp-index-proxy/proxy> ; dcat:endpointDescription <https://wilkinsonlab.github.io/FLAIR-GG/Proxy/index.html> ; dcterms:publisher :publisher-flairgg .
:svc-vp-driada a dcat:DataService ; dcterms:title "Dríada wrapped service"@en ; dcat:endpointURL <https://vp.linkeddata.systems/wrapped-services/driada/lookup> ; dcat:endpointDescription <https://wilkinsonlab.github.io/FLAIR-GG/VP/interfaces/wrapped_services.yaml> ; dcterms:publisher :publisher-flairgg .
:svc-vp-ena    a dcat:DataService ; dcterms:title "TogoWS (DBCLS)"@en ; dcat:endpointURL <http://togows.org/> ; dcat:endpointDescription <https://wilkinsonlab.github.io/FLAIR-GG/VP/interfaces/sequence_lookup.yaml> ; dcterms:publisher :publisher-dbcls .

# ── Semantic model and tooling ──────────────────────────────────────────

:semantic-model
    a dcat:Dataset ;
    dcterms:title "FLAIR-GG semantic model, templates and FLAIR-in-a-Box"@en ;
    dcterms:description "Everything a new bank needs to join: the FAO/IPGRI multi-crop passport descriptor ontology, CSV input templates with paired YARRRML mappings for the germplasm, location and administrative models, and FLAIR-in-a-Box, which installs a triplestore, FAIR Data Point and APIs in one go."@en ;
    dcterms:identifier "FLAIR-GG-semantic-model" ;
    dcterms:version "main (described 2026-10-07)" ;
    dcterms:publisher :publisher-flairgg ;
    dcterms:license <https://opensource.org/license/mit> ;
    dcat:landingPage <https://wilkinsonlab.github.io/FLAIR-GG/SemanticModel/index.html> ;
    dcat:distribution :dist-mcpd-owl , :dist-mcpd-ttl , :dist-csv-templates , :dist-yarrrml , :dist-flair-in-a-box , :dist-onboarding .

:dist-mcpd-owl
    a dcat:Distribution ;
    dcterms:title "Multi-crop passport descriptor ontology — OWL (RDF/XML)"@en ;
    dcterms:description "How to get it: download the OWL file; terms live in the namespace https://w3id.org/fao-ipgr/multi-passport-descriptor.owl# used by every germplasm graph. NB the link on the FLAIR-GG home page (multi-passport-descriptor.owl) returned 404 on 2026-10-07; this is the current file."@en ;
    dcterms:type am:rdf-dump ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ;
    dcterms:format ft:RDF_XML ;
    dcat:accessURL <https://github.com/wilkinsonlab/multi-crop-passport-descriptor-ontology> ;
    dcat:downloadURL <https://wilkinsonlab.github.io/multi-crop-passport-descriptor-ontology/multi-crop-passport-descriptors.owl> .

:dist-mcpd-ttl
    a dcat:Distribution ;
    dcterms:title "Multi-crop passport descriptor ontology — Turtle"@en ;
    dcterms:description "How to get it: download the Turtle serialisation of the same ontology."@en ;
    dcterms:type am:rdf-dump ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:format ft:RDF_TURTLE ;
    dcat:accessURL <https://github.com/wilkinsonlab/multi-crop-passport-descriptor-ontology> ;
    dcat:downloadURL <https://wilkinsonlab.github.io/multi-crop-passport-descriptor-ontology/multi-passport-descriptor.ttl> .

:dist-csv-templates
    a dcat:Distribution ;
    dcterms:title "CSV input templates (germplasm, location, administrative)"@en ;
    dcterms:description "How to get it: export your bank's records into these CSV layouts; they are the only thing a bank has to produce."@en ;
    dcterms:type am:source-repository ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/csv> ;
    dcterms:format ft:CSV ;
    dcat:accessURL <https://github.com/wilkinsonlab/FLAIR-GG/tree/main/SemanticModel/CSV> .

:dist-yarrrml
    a dcat:Distribution ;
    dcterms:title "YARRRML mapping templates"@en ;
    dcterms:description "How to get it: run the YARRRML files with the yarrrml-rmlmapper-docker image to turn the CSV templates into RDF following the semantic model."@en ;
    dcterms:type am:source-repository ;
    dcat:accessURL <https://github.com/wilkinsonlab/FLAIR-GG/tree/main/SemanticModel/YARRRML> .

:dist-flair-in-a-box
    a dcat:Distribution ;
    dcterms:title "FLAIR-in-a-Box — one-command deployment"@en ;
    dcterms:description "How to get it: clone the folder and follow its README; docker compose brings up the triplestore, FAIR Data Point, transformation pipeline and lookup APIs for a new member."@en ;
    dcterms:type am:source-repository ;
    dcat:accessURL <https://github.com/wilkinsonlab/FLAIR-GG/tree/main/FLAIR-in-a-box> .

:dist-onboarding
    a dcat:Distribution ;
    dcterms:title "Onboarding documentation"@en ;
    dcterms:description "How to get it: step-by-step guide for a germplasm bank joining the network; the FLAIR-GG team can also host a temporary endpoint."@en ;
    dcterms:type am:web-portal ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/html> ;
    dcat:accessURL <https://github.com/wilkinsonlab/FLAIR-GG/tree/main/Onboarding> .

# ── World Flora Online backbone ─────────────────────────────────────────

:wfo-backbone
    a dcat:Dataset ;
    dcterms:title "World Flora Online taxonomic backbone (as used by FLAIR-GG)"@en ;
    dcterms:description "The WFO plant taxonomy that FLAIR-GG uses to reconcile species names across banks; every germplasm record points to a WFO identifier."@en ;
    dcterms:identifier "https://w3id.org/bgv-fdp/dataset/7f92e351-bd11-4941-8bcb-4a9046038cb0" ;
    dcterms:version "current" ;
    dcterms:publisher :publisher-wfo ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcat:landingPage <https://www.worldfloraonline.org> ;
    dcat:distribution :dist-wfo-download , :dist-wfo-fdp .

:dist-wfo-download
    a dcat:Distribution ;
    dcterms:title "WFO taxonomic backbone — Darwin Core Archive (latest static version)"@en ;
    dcterms:description "How to get it: the latest DwC-A zip (about 105 MB, CC0) is always at doi:10.5281/zenodo.18007552 together with all earlier versions; the WFO download page lists each version with its own DOI. Match names against it in R with the WorldFlora package."@en ;
    dcterms:type am:darwin-core-archive ;
    dcterms:identifier "https://doi.org/10.5281/zenodo.18007552" ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/zip> ;
    dcterms:format ft:ZIP ;
    dcat:accessURL <https://doi.org/10.5281/zenodo.18007552> ;
    rdfs:seeAlso <https://www.worldfloraonline.org/downloadData> .

:dist-wfo-fdp
    a dcat:Distribution ;
    dcterms:title "WFO backbone record in the BGV-UPM FAIR Data Point"@en ;
    dcterms:description "How to get it: curl -H 'Accept: text/turtle' on the dataset IRI for the DCAT description FLAIR-GG maintains for WFO."@en ;
    dcterms:type am:web-portal ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcat:accessURL <https://w3id.org/bgv-fdp/dataset/7f92e351-bd11-4941-8bcb-4a9046038cb0> .


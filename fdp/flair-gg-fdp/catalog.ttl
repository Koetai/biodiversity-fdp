<https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/>
    a fdp:MetadataService, r3d:Repository ;
    dcterms:title "FLAIR-GG FAIR Data Point — Biodiversity FDP"@en ;
    dcterms:publisher :publisher-curator ;
    dcterms:modified "2026-10-07"^^xsd:date ;
    fdp:hasCatalog :catalog .

:catalog
    a dcat:Catalog ;
    dcterms:title "FLAIR-GG — FAIR network of Spanish plant germplasm banks"@en ;
    dcterms:description "FLAIR-GG makes seed and germplasm banks FAIR without changing their databases: each bank exports CSV templates, YARRRML turns them into RDF following a shared semantic model (germplasm, location, administrative), and each bank runs its own FAIR Data Point and SPARQL endpoints. A Virtual Platform federates queries across all members. Six banks are live; this catalog lists every way to reach them."@en ;
    dcterms:publisher :publisher-flairgg ;
    dcterms:rights <https://wilkinsonlab.github.io/FLAIR-GG/> ;
    dcat:landingPage <https://wilkinsonlab.github.io/FLAIR-GG/> ;
    dcat:keyword "germplasm"@en , "seed bank"@en , "ex situ conservation"@en , "wild flora"@en , "Spain"@en , "FAIR Data Point"@en ;
    dcat:dataset :bgv-2023-06 , :bgusal-2025-02 , :jbclm-2025-10 , :jbo-2024-08 , :jbs-2025-02 , :urjc-2024-11 , :virtual-platform , :semantic-model , :wfo-backbone .

# ── BGV-UPM ────────────────────────────────────────────────────────────

:bgv-2023-06
    a dcat:Dataset ;
    dcterms:title "BGV-UPM germplasm collection — BGV June 2023"@en ;
    dcterms:description "César Gómez Campo Banco de Germoplasma Vegetal de la UPM (Madrid). About 10 000 seed accessions of 3 500 wild plant species, the founding member of FLAIR-GG. Data follow the FLAIR-GG semantic model (FAO/IPGRI multi-crop passport descriptors, SIO, Darwin Core, WFO taxonomy)."@en ;
    dcterms:identifier "https://w3id.org/bgv-fdp" ;
    dcterms:version "2023-06" ;
    dcterms:issued "2023-06-28"^^xsd:date ;
    dcterms:publisher :publisher-bgv ;
    dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ;
    dcat:landingPage <https://w3id.org/bgv-fdp> ;
    rdfs:seeAlso <https://vp.bgv.cbgp.upm.es> ;
    dcat:distribution :dist-bgv-fdp , :dist-bgv-germplasm-sparql , :dist-bgv-location-sparql , :dist-bgv-admin-sparql , :dist-bgv-fdp-sparql , :dist-bgv-iucn , :dist-bgv-species-location .

:dist-bgv-fdp
    a dcat:Distribution ;
    dcterms:title "BGV-UPM FAIR Data Point (native metadata)"@en ;
    dcterms:description "How to get it: open the FDP in a browser, or curl -H 'Accept: text/turtle' https://w3id.org/bgv-fdp and follow fdp:metadataCatalog, dcat:dataset and dcat:distribution to the data services. Runs the FAIR Data Point reference implementation."@en ;
    dcterms:type am:web-portal ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcterms:format ft:RDF_TURTLE ;
    dcat:accessURL <https://w3id.org/bgv-fdp> .

:dist-bgv-germplasm-sparql
    a dcat:Distribution ;
    dcterms:title "BGV-UPM germplasm — SPARQL endpoint"@en ;
    dcterms:description "How to get it: SPARQL 1.1 (RDF4J) at https://w3id.org/bgv-fdp/repositories/germplasm — accessions, species with WFO identifiers, IUCN categories, collecting events (680 459 triples on 2026-10-07). The OpenAPI file documents GET and POST."@en ;
    dcterms:type am:sparql-endpoint ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/sparql-results+json> ;
    dcat:accessURL <https://w3id.org/bgv-fdp/repositories/germplasm> ;
    dcat:accessService :svc-bgv-germplasm .

:dist-bgv-location-sparql
    a dcat:Distribution ;
    dcterms:title "BGV-UPM collecting sites — SPARQL endpoint"@en ;
    dcterms:description "How to get it: SPARQL 1.1 at https://w3id.org/bgv-fdp/repositories/location — country, coordinates and soil conditions of collecting sites (269 882 triples on 2026-10-07)."@en ;
    dcterms:type am:sparql-endpoint ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/sparql-results+json> ;
    dcat:accessURL <https://w3id.org/bgv-fdp/repositories/location> ;
    dcat:accessService :svc-bgv-location .

:dist-bgv-admin-sparql
    a dcat:Distribution ;
    dcterms:title "BGV-UPM administrative data — SPARQL endpoint"@en ;
    dcterms:description "How to get it: SPARQL 1.1 at https://w3id.org/bgv-fdp/repositories/administrative — institute, collecting team and contact information (116 triples on 2026-10-07)."@en ;
    dcterms:type am:sparql-endpoint ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/sparql-results+json> ;
    dcat:accessURL <https://w3id.org/bgv-fdp/repositories/administrative> ;
    dcat:accessService :svc-bgv-admin .

:dist-bgv-fdp-sparql
    a dcat:Distribution ;
    dcterms:title "BGV-UPM FAIR Data Point metadata — SPARQL endpoint"@en ;
    dcterms:description "How to get it: SPARQL 1.1 at https://w3id.org/bgv-fdp/repositories/bgv-fdp to query the DCAT metadata of the whole FDP at once (8 898 triples on 2026-10-07)."@en ;
    dcterms:type am:sparql-endpoint ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/sparql-results+json> ;
    dcat:accessURL <https://w3id.org/bgv-fdp/repositories/bgv-fdp> ;
    dcat:accessService :svc-bgv-fdp-sparql .

:dist-bgv-iucn
    a dcat:Distribution ;
    dcterms:title "BGV-UPM IUCN risk categorisation lookup — CSV / JSON"@en ;
    dcterms:description "How to get it: GET https://bgv.linkeddata.systems/api-local/IUCN_categories (no parameters) lists every species in the bank that is Vulnerable, Endangered or Critically endangered; send Accept: application/json or text/csv. A grlc-style API over the germplasm SPARQL endpoint."@en ;
    dcterms:type am:rest-api ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/csv> ;
    dcterms:format ft:CSV ;
    dcat:accessURL <https://bgv.linkeddata.systems/api-local/IUCN_categories> ;
    dcat:accessService :svc-bgv-api ;
    prov:wasDerivedFrom :dist-bgv-germplasm-sparql .

:dist-bgv-species-location
    a dcat:Distribution ;
    dcterms:title "BGV-UPM collecting-site coordinates by species — JSON"@en ;
    dcterms:description "How to get it: GET https://bgv.linkeddata.systems/api-local/species_location?speciesname=Silene%20vulgaris returns accession numbers with latitude and longitude for that species (the parameter is required)."@en ;
    dcterms:type am:rest-api ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/sparql-results+json> ;
    dcat:accessURL <https://bgv.linkeddata.systems/api-local/species_location> ;
    dcat:accessService :svc-bgv-api ;
    prov:wasDerivedFrom :dist-bgv-location-sparql .


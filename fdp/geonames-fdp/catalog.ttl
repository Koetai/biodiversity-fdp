:svc-ws
    a dcat:DataService ;
    dcterms:title "GeoNames web services"@en ;
    dcat:endpointURL <http://api.geonames.org/> ;
    dcat:endpointDescription <https://www.geonames.org/export/ws-overview.html> ;
    dcterms:publisher :publisher-geonames .

:publisher-geonames  a foaf:Organization ; foaf:name "GeoNames"@en ; foaf:homepage <https://www.geonames.org> .
:publisher-curator   a foaf:Person ; foaf:name "Andra Waagmeester" ; foaf:homepage <https://orcid.org/0000-0001-9773-4008> .
